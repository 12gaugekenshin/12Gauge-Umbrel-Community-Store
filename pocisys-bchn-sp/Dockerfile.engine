FROM golang:1.25.2-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=0.1.0-pocisys" -o /out/pocisys-bch-engine ./cmd/gostratumengine

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/pocisys-bch-engine /usr/local/bin/pocisys-bch-engine
COPY engine-config.json /app/config.json
USER 1000:1000
EXPOSE 3335 8081
ENTRYPOINT ["/usr/local/bin/pocisys-bch-engine", "-config", "/app/config.json"]
